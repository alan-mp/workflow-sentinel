{
  "name": "workflow-sentinel",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Buat dengan: wrangler d1 create sentinel --location apac, lalu isi database_id.
  "d1_databases": [
    { "binding": "DB", "database_name": "sentinel", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "sentinel-files" }],
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    // https://gateway.ai.cloudflare.com/v1/<account_id>/<gateway_id>/anthropic
    "AI_GATEWAY_URL": ""
  },
  // Secret (wrangler secret put): ANTHROPIC_API_KEY, opsional AI_GATEWAY_TOKEN

  "env": {
    // Lingkungan test: Worker "workflow-sentinel-test" di akun Developer Mitra Prodin.
    // Deploy: npm run deploy:test. Binding D1, R2, dan vars tidak diwarisi, jadi ditulis ulang di sini.
    "test": {
      "account_id": "00000000000000000000000000000000",
      "d1_databases": [
        { "binding": "DB", "database_name": "sentinel-test", "database_id": "0c2c3d5d-8254-4658-895d-3c34676d381b", "migrations_dir": "migrations" }
      ],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "sentinel-files-test" }],
      "vars": {
        "AI_GATEWAY_URL": ""
      }
    }
  }
}
